# ---------------------------------------------------------------------------
# iExcel 2.0 In-Basket — environment configuration
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Assessment timing ------------------------------------------------------
# Production: 30. For quick local timeout testing set to 2.
# The value is captured on each session when it STARTS; changing it does not
# affect sessions already in progress.
ASSESSMENT_DURATION_MINUTES=30

# Seconds after expiry during which pending (already-typed) edits that were
# held locally because of a network problem may still reach the server.
# Writes in this window are flagged as "after expiry" in the record.
SUBMISSION_GRACE_SECONDS=60

# Time zone for dates printed in reports and the admin area.
REPORT_TIMEZONE=Asia/Kolkata

# --- Security ---------------------------------------------------------------
# Long random string used to sign login cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Access code for the admin area (/admin).
ADMIN_ACCESS_CODE=

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded local Postgres (PGlite),
# stored in ./.data/pglite. Set it to use Supabase PostgreSQL instead:
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session pooler" or direct connection string.
DATABASE_URL=

# Supabase project keys — reserved for a later move to Supabase Auth/Storage.
# The app currently talks to Postgres directly from the server only; these
# are not required to run. NEVER expose the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
